@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C1 — Контекстная диаграмма системы мониторинга ферм

Person(operator, "Оператор фермы", "Следит за животными и оборудованием")
Person(manager, "Управляющий фермой", "Анализирует отчеты и показатели")

System(smart_farm_system, "Система мониторинга животных", "Автоматизированный мониторинг животных и управления фермой")

System_Ext(security_cameras, "Камеры видеонаблюдения", "IP-камеры для видеоаналитики")
System_Ext(iot_devices, "IoT устройства", "Кормушки, поилки, датчики")
System_Ext(partner_ai, "Партнерская AI", "Нейросетевая модель для детекции")
System_Ext(existing_systems, "Существующие системы", "ERP и системы мониторинга")

' --- Основные взаимодействия ---
Rel(operator, smart_farm_system, "Получает уведомления, управляет оборудованием")
Rel(manager, smart_farm_system, "Просматривает аналитику и отчеты")

Rel(security_cameras, smart_farm_system, "Передает видеопотоки")
Rel(iot_devices, smart_farm_system, "Отправляет телеметрию, получает команды")
Rel(partner_ai, smart_farm_system, "Предоставляет детекции аномалий")
Rel(smart_farm_system, existing_systems, "Синхронизирует данные")
@enduml